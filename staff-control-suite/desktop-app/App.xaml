<Application x:Class="StaffControlSuite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <md:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="LightBlue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Runtime-overridable accent brushes (updated by AppThemeService) -->
            <SolidColorBrush x:Key="NavHighlightBrush"    Color="#2a2a4a"/>
            <SolidColorBrush x:Key="AccentBrush"          Color="#89b4fa"/>
            <SolidColorBrush x:Key="AccentGradientBrush"  Color="#89b4fa"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
