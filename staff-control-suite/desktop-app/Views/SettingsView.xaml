<UserControl x:Class="StaffControlSuite.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="#1e1e2e">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="640">

            <!-- Connection Settings -->
            <md:Card Padding="24" Background="#313244" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <md:PackIcon Kind="Connection" Width="20" Height="20"
                                     Foreground="#89b4fa" VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>
                        <TextBlock Text="Connection Settings"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="Proxy Host"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="Port"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White"/>
                    </Grid>

                    <TextBlock Text="{Binding SaveMessage}"
                               Foreground="#a6e3a1" FontSize="12"
                               Margin="0,0,0,12"
                               Visibility="{Binding HasSaveMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Command="{Binding SaveConnectionCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#89b4fa" Foreground="#1e1e2e"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentSave" Width="16" Height="16"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Save Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </md:Card>

            <!-- Session Info -->
            <md:Card Padding="24" Background="#313244" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <md:PackIcon Kind="Account" Width="20" Height="20"
                                     Foreground="#89b4fa" VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>
                        <TextBlock Text="Current Session"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Username" FontSize="12" Foreground="#6c7086"/>
                        <TextBlock Text="{Binding Username}"
                                   FontSize="12" Foreground="White" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Role" FontSize="12" Foreground="#6c7086"/>
                        <TextBlock Text="{Binding UserRole}"
                                   FontSize="12" Foreground="#cba6f7" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Permissions" FontSize="12" Foreground="#6c7086"/>
                        <TextBlock Text="{Binding PermissionCount}"
                                   FontSize="12" Foreground="#cdd6f4" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Session Token" FontSize="12" Foreground="#6c7086"/>
                        <TextBlock Text="{Binding MaskedToken}"
                                   FontSize="12" Foreground="#45475a" HorizontalAlignment="Right"
                                   FontFamily="Consolas"/>
                    </Grid>

                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#f38ba8" BorderBrush="#f38ba8"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Logout" Width="16" Height="16"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Disconnect &amp; Logout"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </md:Card>

            <!-- Theme Settings (Placeholder) -->
            <md:Card Padding="24" Background="#313244">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <md:PackIcon Kind="Palette" Width="20" Height="20"
                                     Foreground="#89b4fa" VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>
                        <TextBlock Text="Appearance"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Theme customization coming soon."
                               FontSize="13" Foreground="#45475a"/>
                </StackPanel>
            </md:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
