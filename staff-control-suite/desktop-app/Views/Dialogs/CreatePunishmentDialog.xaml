<UserControl x:Class="StaffControlSuite.Views.Dialogs.CreatePunishmentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Width="560" MaxHeight="720">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolConverter            x:Key="InvertedBoolConverter"/>
        <converters:ActionTypeToColorConverter       x:Key="ActionTypeToColorConverter"/>
        <converters:StringToVisibilityConverter      x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <md:Card Background="#313244" Padding="0" md:ElevationAssist.Elevation="Dp8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1e1e2e" Padding="24,16"
                    BorderThickness="0,0,0,1" BorderBrush="#45475a">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Gavel" Width="24" Height="24"
                                 Foreground="#f38ba8" VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center">
                        <Run Text="Punish "/>
                        <Run Text="{Binding TargetName}" Foreground="#89b4fa"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Scrollable body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="24,16,24,0">

                    <!-- Section: Preset Selection -->
                    <Expander Header="Select Presets (optional)"
                              Foreground="#cdd6f4"
                              FontSize="13"
                              BorderThickness="0"
                              Margin="0,0,0,16">
                        <Border Background="#252535" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Loading…"
                                           Foreground="#6c7086" FontSize="12"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4" Padding="8,6"
                                                    CornerRadius="4"
                                                    Background="#313244">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                              Command="{Binding DataContext.TogglePresetCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock>
                                                            <Run Text="{Binding Category}" Foreground="#6c7086" FontSize="11"/>
                                                            <Run Text=" / " Foreground="#45475a" FontSize="11"/>
                                                            <Run Text="{Binding Name}" Foreground="#cdd6f4" FontSize="13" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="#6c7086" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ActionType}"
                                                                   Foreground="{Binding ActionType, Converter={StaticResource ActionTypeToColorConverter}}"
                                                                   FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding DurationDisplay}"
                                                                   Foreground="#cba6f7" FontSize="11"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No presets available."
                                           Foreground="#6c7086" FontSize="12"
                                           Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Presets.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- Section: Calculated Action & Duration -->
                    <Border Background="#252535" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                       Text="Action &amp; Duration"
                                       Foreground="#89b4fa" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{Binding ActionTypes}"
                                      SelectedItem="{Binding SelectedActionType}"
                                      md:HintAssist.Hint="Action Type"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Foreground="White"/>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBox Text="{Binding ManualDurationText, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="Duration (e.g. 7d, 1h30m)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="White"
                                         IsEnabled="{Binding CanOverrideDuration}"/>
                                <TextBlock Foreground="#6c7086" FontSize="11" Margin="0,4,0,0">
                                    <Run Text="Calculated: "/>
                                    <Run Text="{Binding DurationDisplay}" Foreground="#cba6f7"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Section: Reason, Evidence, Server -->
                    <Border Background="#252535" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Punishment Details"
                                       Foreground="#89b4fa" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="Reason (required)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="68"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,12"/>

                            <TextBox Text="{Binding Evidence, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="Evidence (optional – URL or notes)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White"
                                     Margin="0,0,0,12"/>

                            <TextBox Text="{Binding TargetServer, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="Target server (e.g. global, survival)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- Preview section -->
                    <Border Background="#1e1e2e" CornerRadius="6" Padding="14" Margin="0,0,0,16"
                            BorderThickness="1" BorderBrush="#45475a">
                        <StackPanel>
                            <TextBlock Text="Preview" Foreground="#6c7086" FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding PunishmentSummary}"
                                       Foreground="#cdd6f4" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#f38ba8" FontSize="12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer buttons -->
            <Border Grid.Row="2" Padding="24,14"
                    BorderThickness="0,1,0,0" BorderBrush="#45475a">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#6c7086"
                            Margin="0,0,12,0"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                    <Button Command="{Binding ConfirmCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#f38ba8" Foreground="#1e1e2e"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Gavel" Width="16" Height="16"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="CONFIRM PUNISHMENT"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </md:Card>
</UserControl>
