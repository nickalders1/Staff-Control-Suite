<UserControl x:Class="StaffControlSuite.Views.Dialogs.EditPresetDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="540">

    <md:Card Background="#313244" Padding="0" md:ElevationAssist.Elevation="Dp8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1e1e2e" Padding="24,16"
                    BorderThickness="0,0,0,1" BorderBrush="#45475a">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Pencil" Width="22" Height="22"
                                 Foreground="#89b4fa" VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="Edit Preset" FontSize="17" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="24,20,24,8">

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="CategoryBox"
                             md:HintAssist.Hint="Category"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White"/>
                    <TextBox Grid.Column="2" x:Name="NameBox"
                             md:HintAssist.Hint="Name"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White"/>
                </Grid>

                <TextBox x:Name="DescriptionBox" Margin="0,0,0,12"
                         md:HintAssist.Hint="Description (optional)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="White"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" x:Name="ActionTypeBox"
                              md:HintAssist.Hint="Action type"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="White">
                        <ComboBoxItem>WARN</ComboBoxItem>
                        <ComboBoxItem>KICK</ComboBoxItem>
                        <ComboBoxItem>MUTE</ComboBoxItem>
                        <ComboBoxItem>TEMP_MUTE</ComboBoxItem>
                        <ComboBoxItem>BAN</ComboBoxItem>
                        <ComboBoxItem>TEMP_BAN</ComboBoxItem>
                        <ComboBoxItem>IP_BAN</ComboBoxItem>
                        <ComboBoxItem>TEMP_IP_BAN</ComboBoxItem>
                    </ComboBox>

                    <TextBox Grid.Column="2" x:Name="DurationBox"
                             md:HintAssist.Hint="Duration seconds (0 = permanent)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White"/>
                </Grid>

                <!-- Severity slider -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Severity:" Foreground="#6c7086" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SeveritySlider"
                            Minimum="1" Maximum="10" Width="120"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Foreground="#89b4fa"/>
                    <TextBlock Text="{Binding Value, ElementName=SeveritySlider}"
                               Foreground="#cdd6f4" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Flags -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="StackableCheck" Content="Stackable"
                              Foreground="#cdd6f4" Margin="0,0,16,0"/>
                    <CheckBox x:Name="BypassCapCheck" Content="Bypass Cap"
                              Foreground="#cdd6f4" Margin="0,0,16,0"/>
                    <CheckBox x:Name="RequiresIpBanCheck" Content="Requires IP Ban"
                              Foreground="#cdd6f4" Margin="0,0,16,0"/>
                    <CheckBox x:Name="EnabledCheck" Content="Enabled"
                              Foreground="#cdd6f4"/>
                </WrapPanel>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="24,12"
                    BorderThickness="0,1,0,0" BorderBrush="#45475a">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#6c7086" BorderBrush="#6c7086"
                            Margin="0,0,10,0" Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton" Content="Save Changes"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#89b4fa" Foreground="#1e1e2e"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </md:Card>
</UserControl>
