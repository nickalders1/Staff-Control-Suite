<UserControl x:Class="StaffControlSuite.Views.ModerationDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter           x:Key="BoolToVisibilityConverter"/>
        <converters:ActionTypeToColorConverter          x:Key="ActionTypeToColorConverter"/>
        <converters:PunishmentStatusToColorConverter    x:Key="PunishmentStatusToColorConverter"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageFadeIn}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Moderation" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Active punishments and recent moderation activity"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{DynamicResource PurpleBrush}"
                        BorderBrush="{DynamicResource PurpleBrush}"
                        Click="OpenPresetManager">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="FormatListBulleted" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Manage Presets"/>
                    </StackPanel>
                </Button>

                <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                             Margin="12,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Stat cards -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Active Bans -->
            <Border Grid.Column="0" Style="{StaticResource DangerStatCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource DangerBadgeBgBrush}" Margin="0,0,12,0">
                            <md:PackIcon Kind="AccountOff" Width="18" Height="18"
                                         Foreground="{DynamicResource DangerBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Active Bans" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveBans}" Style="{StaticResource StatValueStyle}"
                               Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Border>

            <!-- Active Mutes -->
            <Border Grid.Column="2" Style="{StaticResource WarningStatCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource WarningBadgeBgBrush}" Margin="0,0,12,0">
                            <md:PackIcon Kind="MicrophoneOff" Width="18" Height="18"
                                         Foreground="{DynamicResource WarningBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Active Mutes" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveMutes}" Style="{StaticResource StatValueStyle}"
                               Foreground="{DynamicResource WarningBrush}"/>
                </StackPanel>
            </Border>

            <!-- Punishments Today -->
            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource InfoBadgeBgBrush}" Margin="0,0,12,0">
                            <md:PackIcon Kind="Gavel" Width="18" Height="18"
                                         Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Today" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PunishmentsToday}" Style="{StaticResource StatValueStyle}"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Recent Punishments table -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Recent Punishments" Style="{StaticResource SectionTitleStyle}"/>

            <DataGrid Grid.Row="1"
                      Style="{StaticResource AppDataGridStyle}"
                      ItemsSource="{Binding RecentPunishments}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding CreatedAtDisplay}" Width="155" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Player" Binding="{Binding TargetName}" Width="130" MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding TargetName}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Action type pill -->
                    <DataGridTemplateColumn Header="Action" Width="130" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="6,4">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PillBadgeStyle}">
                                            <Setter Property="Background" Value="{DynamicResource MutedBadgeBgBrush}"/>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ActionType}"
                                               Foreground="{Binding ActionType, Converter={StaticResource ActionTypeToColorConverter}}"
                                               FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Reason}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="110" MinWidth="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource PurpleBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status pill -->
                    <DataGridTemplateColumn Header="Status" Width="100" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="6,4">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PillBadgeStyle}">
                                            <Setter Property="Background" Value="{DynamicResource MutedBadgeBgBrush}"/>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               Foreground="{Binding StatusDisplay, Converter={StaticResource PunishmentStatusToColorConverter}}"
                                               FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Staff" Binding="{Binding CreatedByUsername}" Width="120" MinWidth="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding CreatedByUsername}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
