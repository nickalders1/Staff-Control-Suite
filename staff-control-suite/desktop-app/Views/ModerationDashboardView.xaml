<UserControl x:Class="StaffControlSuite.Views.ModerationDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="#1e1e2e">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter           x:Key="BoolToVisibilityConverter"/>
        <converters:ActionTypeToColorConverter          x:Key="ActionTypeToColorConverter"/>
        <converters:PunishmentStatusToColorConverter    x:Key="PunishmentStatusToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#89b4fa" BorderBrush="#89b4fa"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#cba6f7" BorderBrush="#cba6f7"
                        Click="OpenPresetManager">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="FormatListBulleted" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Manage Presets"/>
                    </StackPanel>
                </Button>

                <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                             Margin="12,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="#89b4fa"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#f38ba8" FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- Stat cards row -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Active Bans -->
            <md:Card Grid.Column="0" Background="#313244" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <md:PackIcon Kind="AccountOff" Width="20" Height="20"
                                     Foreground="#f38ba8" VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                        <TextBlock Text="Active Bans" Foreground="#a6adc8" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveBans}"
                               FontSize="36" FontWeight="Bold"
                               Foreground="#f38ba8"/>
                </StackPanel>
            </md:Card>

            <!-- Active Mutes -->
            <md:Card Grid.Column="2" Background="#313244" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <md:PackIcon Kind="Microphone" Width="20" Height="20"
                                     Foreground="#f9e2af" VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                        <TextBlock Text="Active Mutes" Foreground="#a6adc8" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveMutes}"
                               FontSize="36" FontWeight="Bold"
                               Foreground="#f9e2af"/>
                </StackPanel>
            </md:Card>

            <!-- Punishments Today -->
            <md:Card Grid.Column="4" Background="#313244" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <md:PackIcon Kind="Gavel" Width="20" Height="20"
                                     Foreground="#89b4fa" VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                        <TextBlock Text="Punishments Today" Foreground="#a6adc8" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PunishmentsToday}"
                               FontSize="36" FontWeight="Bold"
                               Foreground="#89b4fa"/>
                </StackPanel>
            </md:Card>
        </Grid>

        <!-- Recent Punishments -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Recent Punishments"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#cdd6f4" Margin="0,0,0,10"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding RecentPunishments}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="#181825"
                      Foreground="#cdd6f4"
                      BorderThickness="1" BorderBrush="#313244"
                      RowBackground="#1e1e2e"
                      AlternatingRowBackground="#252535"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#313244"
                      ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding CreatedAtDisplay}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="Foreground" Value="#6c7086"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Player" Binding="{Binding TargetName}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="Foreground" Value="#89b4fa"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding TargetName}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Action" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ActionType}"
                                           Foreground="{Binding ActionType, Converter={StaticResource ActionTypeToColorConverter}}"
                                           VerticalAlignment="Center" Margin="8,0"
                                           FontWeight="SemiBold" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Reason}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="Foreground" Value="#cba6f7"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusDisplay}"
                                           Foreground="{Binding StatusDisplay, Converter={StaticResource PunishmentStatusToColorConverter}}"
                                           VerticalAlignment="Center" Margin="8,0"
                                           FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Staff" Binding="{Binding CreatedByUsername}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="Foreground" Value="#6c7086"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding CreatedByUsername}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
