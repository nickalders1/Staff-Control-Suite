<UserControl x:Class="StaffControlSuite.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:AgentStatusToColorConverter x:Key="AgentStatusToColorConverter"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageFadeIn}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <TabControl x:Name="MainTabControl"
                Margin="28"
                Background="Transparent"
                BorderThickness="0"
                SelectionChanged="MainTabControl_SelectionChanged">

        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </TabControl.Resources>

        <!-- ═══════════════════════ SERVERS TAB ═══════════════════════ -->
        <TabItem Header="Servers">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,10,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding LoadServersCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddServerCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource SuccessBrush}"
                                Foreground="#1e1e2e"
                                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Plus" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Add Server"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                     Margin="14,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          Style="{StaticResource AppDataGridStyle}"
                          ItemsSource="{Binding Servers}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="110" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding IsOnline, Converter={StaticResource StatusToColorConverter}}"
                                                 Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   Foreground="{Binding IsOnline, Converter={StaticResource StatusToColorConverter}}"
                                                   FontSize="12" FontWeight="Medium"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Server ID" Binding="{Binding ServerId}" Width="140" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding ServerId}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Name" Binding="{Binding ServerName}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding ServerName}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Type" Binding="{Binding ServerType}" Width="100" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Players" Binding="{Binding PlayerDisplay}" Width="80" MinWidth="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="TPS" Binding="{Binding TpsDisplay}" Width="70" MinWidth="55">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="MSPT" Binding="{Binding MsptDisplay}" Width="75" MinWidth="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Last Heartbeat" Binding="{Binding LastHeartbeatDisplay}" Width="130" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Actions" Width="90" MinWidth="80"
                                                Visibility="{Binding DataContext.CanManage,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                        <Button Command="{Binding DataContext.EditServerCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                ToolTip="Edit" Width="28" Height="28">
                                            <md:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.RemoveServerCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding ServerId}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                ToolTip="Remove" Width="28" Height="28">
                                            <md:PackIcon Kind="Delete" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════ AGENT STATUS TAB ═══════════════════════ -->
        <TabItem Header="Agent Status">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,10,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding LoadAgentStatusCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                     Margin="8,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsLoadingAgents, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Real-time updates active"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          Style="{StaticResource AppDataGridStyle}"
                          ItemsSource="{Binding AgentStatuses}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="110" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding Status, Converter={StaticResource AgentStatusToColorConverter}}"
                                                 Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding Status, Converter={StaticResource AgentStatusToColorConverter}}"
                                                   FontSize="12" FontWeight="Medium"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Server ID" Binding="{Binding ServerId}" Width="140" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding ServerId}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Name" Binding="{Binding ServerName}" Width="*" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding ServerName}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Type" Binding="{Binding ServerType}" Width="90" MinWidth="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Version" Binding="{Binding VersionDisplay}" Width="90" MinWidth="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Latency" Binding="{Binding LatencyDisplay}" Width="80" MinWidth="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Last Heartbeat" Binding="{Binding HeartbeatAgeDisplay}" Width="130" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Reconnects" Binding="{Binding ReconnectsDisplay}" Width="95" MinWidth="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PurpleBrush}"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Last Error" Width="200" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastError}"
                                               VerticalAlignment="Center"
                                               Margin="10,0"
                                               Foreground="{DynamicResource DangerBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LastError}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
