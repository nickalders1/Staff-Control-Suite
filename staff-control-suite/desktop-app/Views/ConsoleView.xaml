<UserControl x:Class="StaffControlSuite.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageFadeIn}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Console" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Live server output and command dispatch"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding AvailableServers}"
                          SelectedItem="{Binding SelectedServer}"
                          DisplayMemberPath="ServerName"
                          md:HintAssist.Hint="Select Server"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="200"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,12,0"/>

                <CheckBox Content="Auto-scroll"
                          IsChecked="{Binding AutoScroll}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"/>

                <Button Command="{Binding ClearConsoleCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{DynamicResource DangerBrush}"
                        BorderBrush="{DynamicResource DangerBrush}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Delete" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Clear"/>
                    </StackPanel>
                </Button>

                <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                             Margin="12,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Console output -->
        <Border Grid.Row="2"
                Background="{DynamicResource ConsoleBgBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Effect="{StaticResource SubtleShadow}">
            <ScrollViewer x:Name="ConsoleScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="14">
                <ItemsControl ItemsSource="{Binding ConsoleLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="12"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       TextWrapping="NoWrap"
                                       Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Command input -->
        <Grid Grid.Row="3" Margin="0,12,0,0"
              Visibility="{Binding HasCommandPermission, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="CommandInput"
                     Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="Enter command..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     FontFamily="Consolas, Courier New, monospace"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Background="{DynamicResource ConsoleBgBrush}"
                     KeyDown="CommandInput_KeyDown"/>

            <Button Grid.Column="2"
                    Command="{Binding SendCommandCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="#0f0f1a"
                    FontWeight="SemiBold"
                    Height="44" Padding="18,0">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Send" Width="16" Height="16"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Send"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
