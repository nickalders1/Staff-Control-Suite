<UserControl x:Class="StaffControlSuite.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="#1e1e2e">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding AvailableServers}"
                          SelectedItem="{Binding SelectedServer}"
                          DisplayMemberPath="ServerName"
                          md:HintAssist.Hint="Select Server"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="200"
                          Foreground="White"
                          Margin="0,0,12,0"/>

                <CheckBox Content="Auto-scroll"
                          IsChecked="{Binding AutoScroll}"
                          Foreground="#cdd6f4"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"/>

                <Button Command="{Binding ClearConsoleCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#f38ba8" BorderBrush="#f38ba8">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Delete" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Clear"/>
                    </StackPanel>
                </Button>

                <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                             Margin="12,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="#89b4fa"/>
            </StackPanel>
        </Grid>

        <!-- Console Output -->
        <Border Grid.Row="1"
                Background="#11111b"
                BorderBrush="#313244"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer x:Name="ConsoleScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="12">
                <ItemsControl ItemsSource="{Binding ConsoleLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="12"
                                       Foreground="#a6e3a1"
                                       TextWrapping="NoWrap"
                                       Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Command Input -->
        <Grid Grid.Row="2" Margin="0,12,0,0"
              Visibility="{Binding HasCommandPermission, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="CommandInput"
                     Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="Enter command..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     FontFamily="Consolas, Courier New, monospace"
                     Foreground="White"
                     Background="#11111b"
                     KeyDown="CommandInput_KeyDown"/>

            <Button Grid.Column="2"
                    Command="{Binding SendCommandCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#89b4fa" Foreground="#1e1e2e"
                    Height="44" Padding="16,0">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Send" Width="16" Height="16"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Send"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
