<UserControl x:Class="StaffControlSuite.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageFadeIn}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Audit Logs" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Full history of staff actions and system events"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding ActionFilters}"
                          SelectedItem="{Binding SelectedAction}"
                          md:HintAssist.Hint="Filter by action"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="185"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,10,0"/>

                <TextBox Text="{Binding FilterUsername, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="Filter by user"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Width="150"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         md:TextFieldAssist.HasClearButton="True"
                         Margin="0,0,10,0"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="Search…"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Width="180"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         md:TextFieldAssist.HasClearButton="True"
                         Margin="0,0,10,0"/>

                <Button Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>

                <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="{DynamicResource AccentBrush}"/>
            </WrapPanel>

            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                <Run Text="{Binding Total}"/>
                <Run Text=" total entries"/>
            </TextBlock>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  Style="{StaticResource AppDataGridStyle}"
                  ItemsSource="{Binding Logs}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampDisplay}" Width="165" MinWidth="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="ToolTip" Value="{Binding TimestampDisplay}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="130" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Username}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="240" MinWidth="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Action}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="145" MinWidth="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Target}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Details" Width="*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Details}"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Details}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="140" MinWidth="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding IpAddress}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pagination -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding CanGoPrevious}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ChevronLeft" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Previous"/>
                    </StackPanel>
                </Button>

                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6" Padding="18,8" Margin="0,0,8,0">
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13">
                        <Run Text="Page "/>
                        <Run Text="{Binding CurrentPage}" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages}"/>
                    </TextBlock>
                </Border>

                <Button Command="{Binding NextPageCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        IsEnabled="{Binding CanGoNext}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next"/>
                        <md:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
