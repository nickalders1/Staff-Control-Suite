<UserControl x:Class="StaffControlSuite.Views.PresetManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="#1e1e2e">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolConverter            x:Key="InvertedBoolConverter"/>
        <converters:ActionTypeToColorConverter       x:Key="ActionTypeToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <WrapPanel Orientation="Horizontal">
                <Button Command="{Binding LoadPresetsCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#89b4fa" BorderBrush="#89b4fa"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>

                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          md:HintAssist.Hint="Filter by category"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="160" Foreground="White"
                          Margin="0,0,10,0"/>

                <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="#89b4fa"/>
            </WrapPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#f38ba8" FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- Create preset form (only for managers) -->
        <md:Card Grid.Row="1" Background="#313244" Padding="16" Margin="0,0,0,16"
                 Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}">
            <Expander Header="Create New Preset" Foreground="#cdd6f4" FontSize="13">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0"
                             Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="Category (e.g. Hacking)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White"/>

                    <TextBox Grid.Row="0" Grid.Column="2"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="Preset name"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White"/>

                    <TextBox Grid.Row="0" Grid.Column="4"
                             Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="Description (optional)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White"/>

                    <ComboBox Grid.Row="2" Grid.Column="0"
                              ItemsSource="{Binding ActionTypeOptions}"
                              SelectedItem="{Binding NewActionType}"
                              md:HintAssist.Hint="Action type"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="White"/>

                    <TextBox Grid.Row="2" Grid.Column="2"
                             Text="{Binding NewDurationText, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="Duration seconds (0 = permanent)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White"/>

                    <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal">
                        <TextBlock Text="Severity:" Foreground="#6c7086" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Minimum="1" Maximum="10"
                                Value="{Binding NewSeverity}"
                                Width="80" VerticalAlignment="Center"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Foreground="#89b4fa"/>
                        <TextBlock Text="{Binding NewSeverity}"
                                   Foreground="#cdd6f4" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="4" Grid.ColumnSpan="5" Orientation="Horizontal">
                        <CheckBox Content="Stackable" IsChecked="{Binding NewStackable}"
                                  Foreground="#cdd6f4" Margin="0,0,16,0"/>
                        <CheckBox Content="Bypass Cap" IsChecked="{Binding NewBypassCap}"
                                  Foreground="#cdd6f4" Margin="0,0,16,0"/>
                        <CheckBox Content="Requires IP Ban" IsChecked="{Binding NewRequiresIpBan}"
                                  Foreground="#cdd6f4" Margin="0,0,24,0"/>

                        <Button Command="{Binding CreatePresetCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#a6e3a1" Foreground="#1e1e2e"
                                IsEnabled="{Binding IsCreating, Converter={StaticResource InvertedBoolConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Plus" Width="14" Height="14"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Create Preset"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Expander>
        </md:Card>

        <!-- Presets DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredPresets}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="#181825"
                  Foreground="#cdd6f4"
                  BorderThickness="1" BorderBrush="#313244"
                  RowBackground="#1e1e2e"
                  AlternatingRowBackground="#252535"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#313244"
                  ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="Foreground" Value="#cba6f7"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Name}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="Foreground" Value="#6c7086"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Action" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ActionType}"
                                       Foreground="{Binding ActionType, Converter={StaticResource ActionTypeToColorConverter}}"
                                       VerticalAlignment="Center" Margin="8,0"
                                       FontWeight="SemiBold" FontSize="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="Foreground" Value="#cba6f7"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Sev." Binding="{Binding Severity}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#f9e2af"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Stack" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <md:PackIcon Kind="Check" Width="14" Height="14"
                                         Foreground="#a6e3a1" HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                <md:PackIcon.Style>
                                    <Style TargetType="md:PackIcon">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stackable}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </md:PackIcon.Style>
                            </md:PackIcon>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Cap" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <md:PackIcon Kind="Check" Width="14" Height="14"
                                         Foreground="#fab387" HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                <md:PackIcon.Style>
                                    <Style TargetType="md:PackIcon">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BypassCap}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </md:PackIcon.Style>
                            </md:PackIcon>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="IP Ban" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <md:PackIcon Kind="Check" Width="14" Height="14"
                                         Foreground="#f38ba8" HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                <md:PackIcon.Style>
                                    <Style TargetType="md:PackIcon">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RequiresIpBan}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </md:PackIcon.Style>
                            </md:PackIcon>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Enabled" Width="80"
                                        Visibility="{Binding DataContext.CanManage,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding Enabled, Mode=OneWay}"
                                         Command="{Binding DataContext.ToggleEnabledCommand,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Edit" Width="60"
                                        Visibility="{Binding DataContext.CanManage,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.EditPresetCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Foreground="#89b4fa"
                                    ToolTip="Edit preset"
                                    Width="28" Height="28">
                                <md:PackIcon Kind="Pencil" Width="14" Height="14"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Delete" Width="70"
                                        Visibility="{Binding DataContext.CanManage,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.DeletePresetCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Id}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Foreground="#f38ba8"
                                    ToolTip="Delete preset"
                                    Width="28" Height="28">
                                <md:PackIcon Kind="Delete" Width="14" Height="14"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Entry count -->
        <TextBlock Grid.Row="3"
                   Foreground="#6c7086" FontSize="12"
                   Margin="0,8,0,0" HorizontalAlignment="Right">
            <Run Text="{Binding FilteredPresets.Count, Mode=OneWay}"/>
            <Run Text=" presets"/>
        </TextBlock>
    </Grid>
</UserControl>
