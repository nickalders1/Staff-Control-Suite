<UserControl x:Class="StaffControlSuite.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter         x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════ SIDEBAR ═══════════════════ -->
        <Border Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SubtleBorderBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#181825" Offset="0"/>
                    <GradientStop Color="#13131e" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel>

                <!-- Branding header -->
                <Border DockPanel.Dock="Top"
                        Padding="16,18,16,14"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource SubtleBorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- Logo image (when set) -->
                            <Image Source="{Binding LogoImagePath}"
                                   Width="36" Height="36"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"
                                   Margin="0,0,11,0"
                                   Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Icon fallback (no logo) -->
                            <Border Width="36" Height="36" CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Margin="0,0,11,0"
                                    Visibility="{Binding HasLogo, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2a3a5e" Offset="0"/>
                                        <GradientStop Color="#1a2a4a" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <md:PackIcon Kind="ShieldAccount"
                                             Width="20" Height="20"
                                             Foreground="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SidebarTitle, FallbackValue='Staff Control'}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SidebarSubtitle}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- User info + logout at bottom -->
                <Border DockPanel.Dock="Bottom"
                        Padding="10,10"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource SubtleBorderBrush}">
                    <StackPanel>
                        <!-- User profile card -->
                        <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1e1e35" Offset="0"/>
                                    <GradientStop Color="#252540" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar bubble -->
                                <Border Grid.Column="0"
                                        Width="34" Height="34" CornerRadius="17"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2a3a5e" Offset="0"/>
                                            <GradientStop Color="#1a2a4a" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding UserInitial}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding UserRole}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Logout button -->
                        <Button Command="{Binding LogoutCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource DangerBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                HorizontalAlignment="Stretch"
                                Padding="0,6">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Logout" Width="15" Height="15"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Sign Out" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ListBox x:Name="NavListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,10,0,4">

                            <ListBoxItem Tag="Overview" Style="{StaticResource SidebarNavItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="ViewDashboard" Width="18" Height="18"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Overview"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="Servers" Style="{StaticResource SidebarNavItemStyle}"
                                         Visibility="{Binding CanViewServers, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Server" Width="18" Height="18"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Servers"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="Console" Style="{StaticResource SidebarNavItemStyle}"
                                         Visibility="{Binding CanViewConsole, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Console" Width="18" Height="18"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Console"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="Players" Style="{StaticResource SidebarNavItemStyle}"
                                         Visibility="{Binding CanViewPlayers, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="AccountGroup" Width="18" Height="18"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Players"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="Moderation" Style="{StaticResource SidebarNavItemStyle}"
                                         Visibility="{Binding CanViewModeration, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Gavel" Width="18" Height="18"
                                                 Foreground="{DynamicResource DangerBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Moderation"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="UsersRoles" Style="{StaticResource SidebarNavItemStyle}"
                                         Visibility="{Binding CanViewUsers, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="AccountCog" Width="18" Height="18"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Users &amp; Roles"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="AuditLogs" Style="{StaticResource SidebarNavItemStyle}"
                                         Visibility="{Binding CanViewAudit, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="History" Width="18" Height="18"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Audit Logs"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="Settings" Style="{StaticResource SidebarNavItemStyle}"
                                         Visibility="{Binding CanViewSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="CogOutline" Width="18" Height="18"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Settings"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ═══════════════════ MAIN CONTENT ═══════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource SubtleBorderBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1a1a2a" Offset="0"/>
                        <GradientStop Color="#181825" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="24,0">
                    <TextBlock Text="{Binding CurrentViewTitle}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource SuccessBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding ConnectedServer}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Update banner -->
            <Border Grid.Row="1"
                    Background="{DynamicResource InfoBadgeBgBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Padding="20,8"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="ArrowUpCircle" Width="16" Height="16"
                                     Foreground="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="Version"/>
                            <Run Text="{Binding LatestVersion, Mode=OneWay}"
                                 Foreground="{DynamicResource SuccessBrush}"
                                 FontWeight="SemiBold"/>
                            <Run Text="is available —"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Command="{Binding OpenReleasePageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontSize="12">
                        Download update
                    </Button>
                </Grid>
            </Border>

            <!-- Page content -->
            <ContentControl Grid.Row="2"
                            x:Name="ContentArea"
                            Background="{DynamicResource AppBackgroundBrush}">
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
