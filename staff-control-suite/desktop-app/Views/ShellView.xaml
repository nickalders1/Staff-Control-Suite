<UserControl x:Class="StaffControlSuite.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="#1e1e2e">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="8,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{DynamicResource NavHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#181825"
                BorderThickness="0,0,1,0" BorderBrush="#313244">
            <DockPanel>

                <!-- Sidebar Header -->
                <Border DockPanel.Dock="Top" Padding="16,20,16,16"
                        BorderThickness="0,0,0,1" BorderBrush="#313244">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ShieldAccount"
                                         Width="24" Height="24"
                                         Foreground="#89b4fa"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SidebarTitle, FallbackValue='Staff Control'}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SidebarSubtitle}"
                                   FontSize="11"
                                   Foreground="#6c7086"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Logout at Bottom -->
                <Border DockPanel.Dock="Bottom" Padding="8,8"
                        BorderThickness="0,1,0,0" BorderBrush="#313244">
                    <StackPanel>
                        <!-- User Info -->
                        <Border Padding="16,10,16,10" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32"
                                        CornerRadius="16"
                                        Background="#313244">
                                    <TextBlock Text="{Binding UserInitial}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#89b4fa"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="White"/>
                                    <TextBlock Text="{Binding UserRole}"
                                               FontSize="11"
                                               Foreground="#6c7086"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding LogoutCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#f38ba8"
                                BorderBrush="#f38ba8"
                                HorizontalAlignment="Stretch"
                                Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Logout" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Logout"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Navigation Items -->
                <ListBox x:Name="NavListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,8">

                    <!-- Overview -->
                    <ListBoxItem Tag="Overview" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ViewDashboard" Width="20" Height="20"
                                         Foreground="#89b4fa" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Overview" Foreground="#cdd6f4"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Servers -->
                    <ListBoxItem Tag="Servers" Style="{StaticResource NavItemStyle}"
                                 Visibility="{Binding CanViewServers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Server" Width="20" Height="20"
                                         Foreground="#89b4fa" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Servers" Foreground="#cdd6f4"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Console -->
                    <ListBoxItem Tag="Console" Style="{StaticResource NavItemStyle}"
                                 Visibility="{Binding CanViewConsole, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Console" Width="20" Height="20"
                                         Foreground="#89b4fa" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Console" Foreground="#cdd6f4"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Players -->
                    <ListBoxItem Tag="Players" Style="{StaticResource NavItemStyle}"
                                 Visibility="{Binding CanViewPlayers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountGroup" Width="20" Height="20"
                                         Foreground="#89b4fa" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Players" Foreground="#cdd6f4"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Users & Roles -->
                    <ListBoxItem Tag="UsersRoles" Style="{StaticResource NavItemStyle}"
                                 Visibility="{Binding CanViewUsers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountCog" Width="20" Height="20"
                                         Foreground="#89b4fa" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Users &amp; Roles" Foreground="#cdd6f4"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Settings -->
                    <ListBoxItem Tag="Settings" Style="{StaticResource NavItemStyle}"
                                 Visibility="{Binding CanViewSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Cog" Width="20" Height="20"
                                         Foreground="#89b4fa" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Settings" Foreground="#cdd6f4"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Audit Logs -->
                    <ListBoxItem Tag="AuditLogs" Style="{StaticResource NavItemStyle}"
                                 Visibility="{Binding CanViewAudit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="History" Width="20" Height="20"
                                         Foreground="#89b4fa" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Audit Logs" Foreground="#cdd6f4"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Moderation -->
                    <ListBoxItem Tag="Moderation" Style="{StaticResource NavItemStyle}"
                                 Visibility="{Binding CanViewModeration, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Gavel" Width="20" Height="20"
                                         Foreground="#89b4fa" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Moderation" Foreground="#cdd6f4"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="#181825"
                    BorderThickness="0,0,0,1" BorderBrush="#313244">
                <Grid Margin="20,0">
                    <TextBlock Text="{Binding CurrentViewTitle}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <md:PackIcon Kind="Circle" Width="10" Height="10"
                                     Foreground="#a6e3a1" VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ConnectedServer}"
                                   FontSize="12" Foreground="#6c7086"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Update Banner -->
            <Border Grid.Row="1"
                    Background="#313244"
                    Padding="16,8"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="ArrowUpCircle" Width="16" Height="16"
                                     Foreground="#a6e3a1" VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#cdd6f4">
                            <Run Text="Version"/>
                            <Run Text="{Binding LatestVersion, Mode=OneWay}" Foreground="#a6e3a1" FontWeight="SemiBold"/>
                            <Run Text="is available"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Command="{Binding OpenReleasePageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#89b4fa"
                            FontSize="12">
                        Download update
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Row="2"
                            x:Name="ContentArea"
                            Background="#1e1e2e"/>
        </Grid>
    </Grid>
</UserControl>
