<UserControl x:Class="StaffControlSuite.Views.PlayerModerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter           x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter   x:Key="InvertedBoolToVisibilityConverter"/>
        <converters:InvertedBoolConverter               x:Key="InvertedBoolConverter"/>
        <converters:ActionTypeToColorConverter          x:Key="ActionTypeToColorConverter"/>
        <converters:PunishmentStatusToColorConverter    x:Key="PunishmentStatusToColorConverter"/>
        <converters:StringToVisibilityConverter         x:Key="StringToVisibilityConverter"/>

        <Style x:Key="PunishTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageFadeIn}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Player Moderation" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Search a player to view and manage their punishments"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- Search bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="Enter player name…"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="White"
                     md:TextFieldAssist.HasClearButton="True"
                     Margin="0,0,10,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchPlayerCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Command="{Binding SearchPlayerCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource AccentBrush}" Foreground="#1e1e2e"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Magnify" Width="16" Height="16"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Search"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Command="{Binding OpenPunishDialogCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource DangerBrush}" Foreground="#1e1e2e"
                    Margin="0,0,10,0"
                    Visibility="{Binding CanPunish, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsEnabled="{Binding IsPlayerFound}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Gavel" Width="16" Height="16"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Punish Player"/>
                </StackPanel>
            </Button>

            <ProgressBar Grid.Column="3"
                         IsIndeterminate="True" Width="60" Height="3"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                         Foreground="{DynamicResource AccentBrush}"/>
        </Grid>

        <!-- Error bar -->
        <Border Grid.Row="2" Style="{StaticResource ErrorBarStyle}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="AlertCircle" Foreground="{DynamicResource DangerBrush}"
                             Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Empty placeholder -->
        <Border Grid.Row="3"
                Visibility="{Binding IsPlayerFound, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <md:PackIcon Kind="AccountSearch" Width="56" Height="56"
                             Foreground="{DynamicResource TextMutedBrush}"
                             HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="Search for a player to view their moderation history."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Player found: tabs -->
        <TabControl Grid.Row="3"
                    Visibility="{Binding IsPlayerFound, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="Transparent" BorderThickness="0">

            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource PunishTabItemStyle}"/>
            </TabControl.Resources>

            <!-- Tab: Active Punishments -->
            <TabItem Header="Active Punishments">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,10">
                        <Button Command="{Binding LoadActiveCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="14" Height="14"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              Style="{StaticResource AppDataGridStyle}"
                              ItemsSource="{Binding ActivePunishments}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding CreatedAtDisplay}" Width="155" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Action" Width="130" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,4" Style="{StaticResource MutedPillStyle}">
                                            <TextBlock Text="{Binding ActionType}"
                                                       Foreground="{Binding ActionType, Converter={StaticResource ActionTypeToColorConverter}}"
                                                       FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Reason}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="110" MinWidth="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PurpleBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresDisplay}" Width="155" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Staff" Binding="{Binding CreatedByUsername}" Width="120" MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Revoke" Width="90" MinWidth="80"
                                                    Visibility="{Binding DataContext.CanRevoke,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RevokeCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="{DynamicResource SuccessBrush}"
                                                BorderBrush="{DynamicResource SuccessBrush}"
                                                Padding="8,4" Margin="6,3"
                                                FontSize="11">
                                            Revoke
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab: History -->
            <TabItem Header="History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,10">
                        <ComboBox ItemsSource="{Binding ActionTypeFilters}"
                                  SelectedItem="{Binding FilterActionType}"
                                  md:HintAssist.Hint="Action type"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="150" Foreground="White"
                                  Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding FilterStatus}"
                                  md:HintAssist.Hint="Status"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="120" Foreground="White"
                                  Margin="0,0,10,0"/>
                        <Button Command="{Binding LoadHistoryCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="14" Height="14"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <DataGrid Grid.Row="1"
                              Style="{StaticResource AppDataGridStyle}"
                              ItemsSource="{Binding History}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding CreatedAtDisplay}" Width="155" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Action" Width="130" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,4" Style="{StaticResource MutedPillStyle}">
                                            <TextBlock Text="{Binding ActionType}"
                                                       Foreground="{Binding ActionType, Converter={StaticResource ActionTypeToColorConverter}}"
                                                       FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Reason}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="110" MinWidth="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PurpleBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Status" Width="100" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,4" Style="{StaticResource MutedPillStyle}">
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       Foreground="{Binding StatusDisplay, Converter={StaticResource PunishmentStatusToColorConverter}}"
                                                       FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Staff" Binding="{Binding CreatedByUsername}" Width="120" MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Revoke" Width="90" MinWidth="80"
                                                    Visibility="{Binding DataContext.CanRevoke,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RevokeCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="{DynamicResource SuccessBrush}"
                                                BorderBrush="{DynamicResource SuccessBrush}"
                                                Padding="8,4" Margin="6,3"
                                                FontSize="11"
                                                IsEnabled="{Binding Active}">
                                            Revoke
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab: Notes -->
            <TabItem Header="Notes"
                     Visibility="{Binding CanViewNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,12">
                        <Button Command="{Binding LoadNotesCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="14" Height="14"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource NoteCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Width="26" Height="26" CornerRadius="13"
                                                        Background="{DynamicResource InfoBadgeBgBrush}"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding CreatedByUsername[0]}"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding CreatedByUsername}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding CreatedAtDisplay}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           FontFamily="Consolas"/>
                                                <Border Background="{DynamicResource MutedBadgeBgBrush}"
                                                        CornerRadius="8" Padding="7,2" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Visibility}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="10"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Note}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13" TextWrapping="Wrap"
                                                       LineHeight="20"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add note -->
                    <Border Grid.Row="2"
                            Visibility="{Binding CanCreateNotes, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource NoteCardStyle}"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="Add a staff note…"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White"
                                     Margin="0,0,12,0"
                                     IsEnabled="{Binding IsAddingNote, Converter={StaticResource InvertedBoolConverter}}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding AddNoteCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Grid.Column="1"
                                    Command="{Binding AddNoteCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource AccentBrush}" Foreground="#1e1e2e"
                                    IsEnabled="{Binding IsAddingNote, Converter={StaticResource InvertedBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Plus" Width="14" Height="14"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add Note"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
