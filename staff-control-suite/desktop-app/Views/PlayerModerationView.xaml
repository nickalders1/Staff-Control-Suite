<UserControl x:Class="StaffControlSuite.Views.PlayerModerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="#1e1e2e">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter           x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter   x:Key="InvertedBoolToVisibilityConverter"/>
        <converters:InvertedBoolConverter               x:Key="InvertedBoolConverter"/>
        <converters:ActionTypeToColorConverter          x:Key="ActionTypeToColorConverter"/>
        <converters:PunishmentStatusToColorConverter    x:Key="PunishmentStatusToColorConverter"/>
        <converters:StringToVisibilityConverter         x:Key="StringToVisibilityConverter"/>

        <Style x:Key="TabItemStyle" TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="Enter player name…"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="White"
                     md:TextFieldAssist.HasClearButton="True"
                     Margin="0,0,10,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchPlayerCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Command="{Binding SearchPlayerCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#89b4fa" Foreground="#1e1e2e"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Magnify" Width="16" Height="16"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Search"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Command="{Binding OpenPunishDialogCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#f38ba8" Foreground="#1e1e2e"
                    Margin="0,0,10,0"
                    Visibility="{Binding CanPunish, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsEnabled="{Binding IsPlayerFound}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Gavel" Width="16" Height="16"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Punish Player"/>
                </StackPanel>
            </Button>

            <ProgressBar Grid.Column="3"
                         IsIndeterminate="True" Width="60" Height="4"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                         Foreground="#89b4fa"/>
        </Grid>

        <!-- Error / status bar -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}"
                   Foreground="#f38ba8" FontSize="12"
                   Margin="0,0,0,12"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- No player selected placeholder -->
        <Border Grid.Row="2"
                Visibility="{Binding IsPlayerFound, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <md:PackIcon Kind="AccountSearch" Width="64" Height="64"
                             Foreground="#313244" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Search for a player to view their moderation history."
                           Foreground="#6c7086" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Player found: tabs -->
        <TabControl Grid.Row="2"
                    Visibility="{Binding IsPlayerFound, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="Transparent" BorderThickness="0">

            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabItemStyle}"/>
            </TabControl.Resources>

            <!-- Tab 1: Active Punishments -->
            <TabItem Header="Active Punishments">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,10">
                        <Button Command="{Binding LoadActiveCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#89b4fa" BorderBrush="#89b4fa">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="14" Height="14"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ActivePunishments}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="#181825"
                              Foreground="#cdd6f4"
                              BorderThickness="1" BorderBrush="#313244"
                              RowBackground="#1e1e2e"
                              AlternatingRowBackground="#252535"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#313244"
                              ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding CreatedAtDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#6c7086"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActionType}"
                                                   Foreground="{Binding ActionType, Converter={StaticResource ActionTypeToColorConverter}}"
                                                   VerticalAlignment="Center" Margin="8,0"
                                                   FontWeight="SemiBold" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Reason}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#cba6f7"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#6c7086"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Staff" Binding="{Binding CreatedByUsername}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#89b4fa"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Actions" Width="90"
                                                    Visibility="{Binding DataContext.CanRevoke,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RevokeCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#a6e3a1" BorderBrush="#a6e3a1"
                                                Padding="8,4" Margin="4,2"
                                                FontSize="11">
                                            Revoke
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 2: History -->
            <TabItem Header="History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,10">
                        <ComboBox ItemsSource="{Binding ActionTypeFilters}"
                                  SelectedItem="{Binding FilterActionType}"
                                  md:HintAssist.Hint="Action type"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="150" Foreground="White"
                                  Margin="0,0,10,0"/>

                        <ComboBox ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding FilterStatus}"
                                  md:HintAssist.Hint="Status"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="120" Foreground="White"
                                  Margin="0,0,10,0"/>

                        <Button Command="{Binding LoadHistoryCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#89b4fa" BorderBrush="#89b4fa">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="14" Height="14"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding History}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="#181825"
                              Foreground="#cdd6f4"
                              BorderThickness="1" BorderBrush="#313244"
                              RowBackground="#1e1e2e"
                              AlternatingRowBackground="#252535"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#313244"
                              ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding CreatedAtDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#6c7086"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Action" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActionType}"
                                                   Foreground="{Binding ActionType, Converter={StaticResource ActionTypeToColorConverter}}"
                                                   VerticalAlignment="Center" Margin="8,0"
                                                   FontWeight="SemiBold" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Reason}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#cba6f7"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   Foreground="{Binding StatusDisplay, Converter={StaticResource PunishmentStatusToColorConverter}}"
                                                   VerticalAlignment="Center" Margin="8,0"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Staff" Binding="{Binding CreatedByUsername}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#89b4fa"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Actions" Width="90"
                                                    Visibility="{Binding DataContext.CanRevoke,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RevokeCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#a6e3a1" BorderBrush="#a6e3a1"
                                                Padding="8,4" Margin="4,2"
                                                FontSize="11"
                                                IsEnabled="{Binding Active}">
                                            Revoke
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Notes -->
            <TabItem Header="Notes"
                     Visibility="{Binding CanViewNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,10">
                        <Button Command="{Binding LoadNotesCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#89b4fa" BorderBrush="#89b4fa">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="14" Height="14"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252535" CornerRadius="6" Padding="14"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                <md:PackIcon Kind="AccountCircle" Width="16" Height="16"
                                                             Foreground="#89b4fa" VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding CreatedByUsername}"
                                                           Foreground="#89b4fa" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding CreatedAtDisplay}"
                                                           Foreground="#6c7086" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding Visibility}"
                                                           Foreground="#45475a" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Note}"
                                                       Foreground="#cdd6f4" FontSize="13"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add note -->
                    <Border Grid.Row="2"
                            Visibility="{Binding CanCreateNotes, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#252535" CornerRadius="6" Padding="14" Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="Add a staff note…"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White"
                                     Margin="0,0,10,0"
                                     IsEnabled="{Binding IsAddingNote, Converter={StaticResource InvertedBoolConverter}}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding AddNoteCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Grid.Column="1"
                                    Command="{Binding AddNoteCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#89b4fa" Foreground="#1e1e2e"
                                    IsEnabled="{Binding IsAddingNote, Converter={StaticResource InvertedBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Plus" Width="14" Height="14"
                                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Add Note"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
