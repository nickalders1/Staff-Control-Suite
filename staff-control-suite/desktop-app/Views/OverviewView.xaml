<UserControl x:Class="StaffControlSuite.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageFadeIn}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <!-- Page header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Network Overview" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Real-time status across all connected servers"
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- ── Stat cards ────────────────────────────────────── -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Servers -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource InfoBadgeBgBrush}" Margin="0,0,12,0">
                                <md:PackIcon Kind="Server" Width="18" Height="18"
                                             Foreground="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Servers" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalServers}" Style="{StaticResource StatValueStyle}"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Online Servers -->
                <Border Grid.Column="2" Style="{StaticResource SuccessStatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SuccessBadgeBgBrush}" Margin="0,0,12,0">
                                <md:PackIcon Kind="CheckCircle" Width="18" Height="18"
                                             Foreground="{DynamicResource SuccessBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Online" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OnlineServers}" Style="{StaticResource StatValueStyle}"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Online Players -->
                <Border Grid.Column="4" Style="{StaticResource PurpleStatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource PurpleBadgeBgBrush}" Margin="0,0,12,0">
                                <md:PackIcon Kind="AccountGroup" Width="18" Height="18"
                                             Foreground="{DynamicResource PurpleBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Online Players" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalPlayers}" Style="{StaticResource StatValueStyle}"
                                   Foreground="{DynamicResource PurpleBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Avg TPS -->
                <Border Grid.Column="6" Style="{StaticResource WarningStatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource WarningBadgeBgBrush}" Margin="0,0,12,0">
                                <md:PackIcon Kind="Speedometer" Width="18" Height="18"
                                             Foreground="{DynamicResource WarningBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Avg TPS" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AverageTps, StringFormat={}{0:F1}}" Style="{StaticResource StatValueStyle}"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Content row ────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Servers list -->
                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Servers" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding LoadCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="Refresh" Width="28" Height="28">
                                <md:PackIcon Kind="Refresh" Width="16" Height="16"/>
                            </Button>
                            <ProgressBar IsIndeterminate="True" Width="50" Height="3"
                                         Margin="8,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                         Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ContentCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status dot -->
                                        <Ellipse Grid.Column="0" Width="9" Height="9"
                                                 Fill="{Binding IsOnline, Converter={StaticResource StatusToColorConverter}}"
                                                 VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <!-- Name + ID -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ServerName}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ServerId}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Players -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    Margin="0,0,20,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PlayerDisplay}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="players" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- TPS -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding TpsDisplay}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="tps" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Status badge -->
                                        <Border Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource PillBadgeStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBadgeBgBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBadgeBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <Binding Path="IsOnline"
                                                             Converter="{StaticResource StatusToColorConverter}"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border HorizontalAlignment="Center" Margin="0,24" VerticalAlignment="Center"
                            Visibility="{Binding NoServers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <md:PackIcon Kind="ServerOff" Width="40" Height="40"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No servers configured."
                                       Style="{StaticResource EmptyStateTextStyle}"
                                       Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Recent Activity feed -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Recent Activity" Style="{StaticResource SectionTitleStyle}"
                               Visibility="{Binding CanViewAudit, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding RecentActivity}"
                                  Visibility="{Binding CanViewAudit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="6" Height="6"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Username}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Action}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TimestampDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No recent activity."
                               Style="{StaticResource EmptyStateTextStyle}"
                               Margin="0,16"
                               Visibility="{Binding NoRecentActivity, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
