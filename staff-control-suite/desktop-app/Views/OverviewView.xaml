<UserControl x:Class="StaffControlSuite.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="#1e1e2e">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Stats Row -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Servers -->
                <md:Card Grid.Column="0" Padding="20" Background="#313244">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <md:PackIcon Kind="Server" Width="20" Height="20"
                                         Foreground="#89b4fa" VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                            <TextBlock Text="Total Servers" Foreground="#6c7086" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalServers}" FontSize="32"
                                   FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </md:Card>

                <!-- Online Servers -->
                <md:Card Grid.Column="2" Padding="20" Background="#313244">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <md:PackIcon Kind="CheckCircle" Width="20" Height="20"
                                         Foreground="#a6e3a1" VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                            <TextBlock Text="Online Servers" Foreground="#6c7086" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OnlineServers}" FontSize="32"
                                   FontWeight="Bold" Foreground="#a6e3a1"/>
                    </StackPanel>
                </md:Card>

                <!-- Total Players -->
                <md:Card Grid.Column="4" Padding="20" Background="#313244">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <md:PackIcon Kind="AccountGroup" Width="20" Height="20"
                                         Foreground="#cba6f7" VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                            <TextBlock Text="Online Players" Foreground="#6c7086" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalPlayers}" FontSize="32"
                                   FontWeight="Bold" Foreground="#cba6f7"/>
                    </StackPanel>
                </md:Card>

                <!-- Avg TPS -->
                <md:Card Grid.Column="6" Padding="20" Background="#313244">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <md:PackIcon Kind="Speedometer" Width="20" Height="20"
                                         Foreground="#f9e2af" VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                            <TextBlock Text="Avg TPS" Foreground="#6c7086" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AverageTps, StringFormat={}{0:F1}}" FontSize="32"
                                   FontWeight="Bold" Foreground="#f9e2af"/>
                    </StackPanel>
                </md:Card>
            </Grid>

            <!-- Content Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Servers List -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Servers" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Button Command="{Binding LoadCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="#89b4fa"
                                ToolTip="Refresh"
                                Margin="8,0,0,0">
                            <md:PackIcon Kind="Refresh" Width="18" Height="18"/>
                        </Button>
                        <ProgressBar IsIndeterminate="True"
                                     Width="60" Height="4"
                                     Margin="8,0,0,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Foreground="#89b4fa"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <md:Card Margin="0,0,0,8" Padding="16" Background="#313244">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Dot -->
                                        <Ellipse Grid.Column="0"
                                                 Width="10" Height="10"
                                                 Fill="{Binding IsOnline, Converter={StaticResource StatusToColorConverter}}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>

                                        <!-- Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ServerName}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding ServerId}"
                                                       FontSize="11" Foreground="#6c7086"/>
                                        </StackPanel>

                                        <!-- Players -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    Margin="0,0,16,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PlayerDisplay}"
                                                       FontSize="13" Foreground="#cdd6f4"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="players" FontSize="11"
                                                       Foreground="#6c7086" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- TPS -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding TpsDisplay}"
                                                       FontSize="13" Foreground="#f9e2af"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="tps" FontSize="11"
                                                       Foreground="#6c7086" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding StatusDisplay}"
                                                   FontSize="12" FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{Binding IsOnline, Converter={StaticResource StatusToColorConverter}}"/>
                                    </Grid>
                                </md:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No servers configured."
                               Foreground="#45475a" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,20"
                               Visibility="{Binding NoServers, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Recent Activity -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Recent Activity" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" Margin="0,0,0,16"
                               Visibility="{Binding CanViewAudit, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding RecentActivity}"
                                  Visibility="{Binding CanViewAudit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#313244" Padding="0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="#89b4fa"/>
                                            <TextBlock Text=" — " Foreground="#6c7086" FontSize="13"/>
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="13" Foreground="#cdd6f4"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TimestampDisplay}"
                                                   FontSize="11" Foreground="#45475a"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No recent activity."
                               Foreground="#45475a" FontSize="13"
                               Margin="0,20"
                               Visibility="{Binding NoRecentActivity, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
