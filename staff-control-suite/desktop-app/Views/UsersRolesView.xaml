<UserControl x:Class="StaffControlSuite.Views.UsersRolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="#1e1e2e">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <TabControl Style="{StaticResource MaterialDesignTabControl}"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- Users Tab -->
            <TabItem Header="USERS"
                     Foreground="White"
                     Style="{StaticResource MaterialDesignTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Users Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Command="{Binding LoadUsersCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#89b4fa" BorderBrush="#89b4fa"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CreateUserCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#89b4fa" Foreground="#1e1e2e"
                                Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="AccountPlus" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Add User"/>
                            </StackPanel>
                        </Button>

                        <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                                     Margin="12,0,0,0"
                                     Visibility="{Binding IsLoadingUsers, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Foreground="#89b4fa"/>
                    </StackPanel>

                    <!-- Error -->
                    <Border Grid.Row="0" Background="#3b0000" CornerRadius="4" Padding="12,8"
                            Margin="0,48,0,0"
                            Visibility="{Binding HasUserError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding UserErrorMessage}"
                                   Foreground="#f38ba8" FontSize="12"/>
                    </Border>

                    <!-- Users DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Users}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="#181825"
                              Foreground="#cdd6f4"
                              BorderThickness="1" BorderBrush="#313244"
                              RowBackground="#1e1e2e"
                              AlternatingRowBackground="#252535"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#313244"
                              ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#cba6f7"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" FontSize="12"
                                                   Foreground="{Binding IsActive, Converter={StaticResource StatusToColorConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtDisplay}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#6c7086"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="100"
                                                    Visibility="{Binding DataContext.CanManageUsers,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                            <Button Command="{Binding DataContext.EditUserCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Foreground="#89b4fa" Width="28" Height="28"
                                                    ToolTip="Edit">
                                                <md:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteUserCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Foreground="#f38ba8" Width="28" Height="28"
                                                    ToolTip="Delete">
                                                <md:PackIcon Kind="Delete" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Roles Tab -->
            <TabItem Header="ROLES"
                     Foreground="White"
                     Style="{StaticResource MaterialDesignTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Roles Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Command="{Binding LoadRolesCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#89b4fa" BorderBrush="#89b4fa"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CreateRoleCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#a6e3a1" Foreground="#1e1e2e"
                                Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Plus" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Add Role"/>
                            </StackPanel>
                        </Button>

                        <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                                     Margin="12,0,0,0"
                                     Visibility="{Binding IsLoadingRoles, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Foreground="#89b4fa"/>
                    </StackPanel>

                    <!-- Roles DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Roles}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="#181825"
                              Foreground="#cdd6f4"
                              BorderThickness="1" BorderBrush="#313244"
                              RowBackground="#1e1e2e"
                              AlternatingRowBackground="#252535"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#313244"
                              ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#89b4fa"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Permissions" Binding="{Binding PermissionCount}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#6c7086"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtDisplay}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="Foreground" Value="#6c7086"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Actions" Width="100"
                                                    Visibility="{Binding DataContext.IsOwner,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                            <Button Command="{Binding DataContext.EditRoleCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Foreground="#89b4fa" Width="28" Height="28"
                                                    ToolTip="Edit Permissions">
                                                <md:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteRoleCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Foreground="#f38ba8" Width="28" Height="28"
                                                    ToolTip="Delete"
                                                    IsEnabled="{Binding IsSystemRole, Converter={StaticResource InvertedBoolConverter}}">
                                                <md:PackIcon Kind="Delete" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
