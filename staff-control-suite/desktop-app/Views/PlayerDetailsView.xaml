<UserControl x:Class="StaffControlSuite.Views.PlayerDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StaffControlSuite.Converters"
             Background="#1e1e2e">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:BoolToOnlineStringConverter x:Key="BoolToOnlineStringConverter"/>
        <converters:FirstLetterConverter x:Key="FirstLetterConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Back + Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#89b4fa" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ArrowLeft" Width="18" Height="18"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Back to Players"/>
                    </StackPanel>
                </Button>

                <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="#89b4fa"/>
            </StackPanel>

            <!-- Player Info Card -->
            <md:Card Padding="24" Background="#313244" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="#89b4fa" Margin="0,0,20,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding Player.Name, Converter={StaticResource FirstLetterConverter}}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#1e1e2e"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Player.Name}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                            <Ellipse Width="10" Height="10" Margin="12,0,6,0"
                                     Fill="{Binding Player.IsOnline, Converter={StaticResource StatusToColorConverter}}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Player.IsOnline, Converter={StaticResource BoolToOnlineStringConverter}}"
                                       FontSize="13"
                                       Foreground="{Binding Player.IsOnline, Converter={StaticResource StatusToColorConverter}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Player.Uuid}"
                                   FontSize="11" Foreground="#6c7086"
                                   Margin="0,4,0,0" FontFamily="Consolas"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="#2a3a5a" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Player.ServerId}"
                                           FontSize="12" Foreground="#89b4fa"/>
                            </Border>
                            <Border Background="#2a3a5a" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="{Binding Player.Gamemode}"
                                           FontSize="12" Foreground="#cba6f7"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </md:Card>

            <!-- Stats Grid -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <md:Card Grid.Column="0" Padding="20" Background="#313244">
                    <StackPanel>
                        <TextBlock Text="Stats" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#89b4fa" Margin="0,0,0,16"/>

                        <!-- Health -->
                        <TextBlock Text="Health" FontSize="12" Foreground="#6c7086" Margin="0,0,0,4"/>
                        <StackPanel Margin="0,0,0,12">
                            <ProgressBar Value="{Binding Player.Health}"
                                         Maximum="20" Height="8"
                                         Foreground="#f38ba8" Background="#3a3a4a"/>
                            <TextBlock Text="{Binding Player.Health, StringFormat={}{0:F1}/20}"
                                       FontSize="11" Foreground="#cdd6f4" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <!-- Food -->
                        <TextBlock Text="Food Level" FontSize="12" Foreground="#6c7086" Margin="0,0,0,4"/>
                        <StackPanel Margin="0,0,0,12">
                            <ProgressBar Value="{Binding Player.FoodLevel}"
                                         Maximum="20" Height="8"
                                         Foreground="#f9e2af" Background="#3a3a4a"/>
                            <TextBlock Text="{Binding Player.FoodLevel, StringFormat={}{0}/20}"
                                       FontSize="11" Foreground="#cdd6f4" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <!-- Ping -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Ping" FontSize="12" Foreground="#6c7086"/>
                            <TextBlock Text="{Binding Player.PingDisplay}"
                                       FontSize="12" Foreground="#f9e2af" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- World -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="World" FontSize="12" Foreground="#6c7086"/>
                            <TextBlock Text="{Binding Player.World}"
                                       FontSize="12" Foreground="#cdd6f4" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </md:Card>

                <!-- Right Column -->
                <md:Card Grid.Column="2" Padding="20" Background="#313244">
                    <StackPanel>
                        <TextBlock Text="Activity" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#89b4fa" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Playtime" FontSize="12" Foreground="#6c7086"/>
                            <TextBlock Text="{Binding Player.PlaytimeDisplay}"
                                       FontSize="12" Foreground="#cdd6f4" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="First Joined" FontSize="12" Foreground="#6c7086"/>
                            <TextBlock Text="{Binding FirstJoinedDisplay}"
                                       FontSize="12" Foreground="#cdd6f4" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Last Seen" FontSize="12" Foreground="#6c7086"/>
                            <TextBlock Text="{Binding Player.LastJoinedDisplay}"
                                       FontSize="12" Foreground="#cdd6f4" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </md:Card>
            </Grid>

            <!-- Punishments -->
            <md:Card Padding="20" Background="#313244" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Punishment History" FontSize="14" FontWeight="SemiBold"
                               Foreground="#89b4fa" Margin="0,0,0,16"/>
                    <TextBlock Text="No punishments on record."
                               FontSize="13" Foreground="#45475a"
                               HorizontalAlignment="Center" Margin="0,10"/>
                </StackPanel>
            </md:Card>

            <!-- Notes -->
            <md:Card Padding="20" Background="#313244">
                <StackPanel>
                    <TextBlock Text="Staff Notes" FontSize="14" FontWeight="SemiBold"
                               Foreground="#89b4fa" Margin="0,0,0,16"/>
                    <TextBlock Text="No notes added yet."
                               FontSize="13" Foreground="#45475a"
                               HorizontalAlignment="Center" Margin="0,10"/>
                </StackPanel>
            </md:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
