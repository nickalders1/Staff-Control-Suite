<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- ══════════════════════════════════════════════════════
         DATAGRID — implicit + named styles
    ══════════════════════════════════════════════════════ -->

    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="MinHeight"   Value="36"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TableHoverBgBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2a3a5e"/>
                <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding"          Value="0,4"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background"               Value="{DynamicResource TableBgBrush}"/>
        <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="RowBackground"            Value="{DynamicResource TableRowBgBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource TableAltRowBgBrush}"/>
        <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SubtleBorderBrush}"/>
        <Setter Property="CanUserAddRows"           Value="False"/>
        <Setter Property="IsReadOnly"               Value="True"/>
        <Setter Property="AutoGenerateColumns"      Value="False"/>
        <Setter Property="SelectionMode"            Value="Single"/>
        <Setter Property="HeadersVisibility"        Value="Column"/>
        <Setter Property="ColumnHeaderStyle"        Value="{StaticResource MaterialDesignDataGridColumnHeader}"/>
        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        <Setter Property="RowHeight"                Value="36"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         CARDS
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="AppCardStyle" TargetType="md:Card">
        <Setter Property="Background"  Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="Padding"     Value="20"/>
        <Setter Property="Margin"      Value="0,0,0,12"/>
        <Setter Property="md:ElevationAssist.Elevation" Value="Dp4"/>
    </Style>

    <!-- Flat border-based stat card with accent top stripe -->
    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="20"/>
        <Setter Property="BorderThickness" Value="0,2,0,0"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Effect"          Value="{StaticResource CardShadow}"/>
    </Style>

    <Style x:Key="DangerStatCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style x:Key="WarningStatCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
    </Style>

    <Style x:Key="SuccessStatCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <Style x:Key="PurpleStatCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource PurpleBrush}"/>
    </Style>

    <!-- Elevated content card (server cards, note cards, etc.) -->
    <Style x:Key="ContentCardStyle" TargetType="Border">
        <Setter Property="Background"   Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="16"/>
        <Setter Property="Margin"       Value="0,0,0,8"/>
        <Setter Property="Effect"       Value="{StaticResource SubtleShadow}"/>
    </Style>

    <!-- Note card style -->
    <Style x:Key="NoteCardStyle" TargetType="Border">
        <Setter Property="Background"   Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="14"/>
        <Setter Property="Margin"       Value="0,0,0,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"  Value="{DynamicResource SubtleBorderBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         STATUS PILL BADGES
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="PillBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius"         Value="10"/>
        <Setter Property="Padding"              Value="10,3"/>
        <Setter Property="HorizontalAlignment"  Value="Left"/>
        <Setter Property="VerticalAlignment"    Value="Center"/>
    </Style>

    <Style x:Key="SuccessPillStyle" TargetType="Border" BasedOn="{StaticResource PillBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource SuccessBadgeBgBrush}"/>
    </Style>

    <Style x:Key="DangerPillStyle" TargetType="Border" BasedOn="{StaticResource PillBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource DangerBadgeBgBrush}"/>
    </Style>

    <Style x:Key="WarningPillStyle" TargetType="Border" BasedOn="{StaticResource PillBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource WarningBadgeBgBrush}"/>
    </Style>

    <Style x:Key="InfoPillStyle" TargetType="Border" BasedOn="{StaticResource PillBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource InfoBadgeBgBrush}"/>
    </Style>

    <Style x:Key="PurplePillStyle" TargetType="Border" BasedOn="{StaticResource PillBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource PurpleBadgeBgBrush}"/>
    </Style>

    <Style x:Key="MutedPillStyle" TargetType="Border" BasedOn="{StaticResource PillBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource MutedBadgeBgBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         SIDEBAR NAV ITEM  — animated with opacity layers
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="SidebarNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding"                    Value="12,10"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="8,2,10,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Accent bar (left edge, shows when selected) -->
                        <Border x:Name="AccentBar"
                                Grid.Column="0"
                                CornerRadius="2,0,0,2"
                                Background="Transparent"/>

                        <Grid Grid.Column="1">
                            <!-- Selection background layer -->
                            <Border x:Name="SelectionBg"
                                    CornerRadius="6"
                                    Background="{DynamicResource NavHighlightBrush}"
                                    Opacity="0"/>

                            <!-- Hover background layer -->
                            <Border x:Name="HoverBg"
                                    CornerRadius="6"
                                    Background="#1e1e2e"
                                    Opacity="0"/>

                            <!-- Content -->
                            <Border CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionBg" Property="Opacity" Value="1"/>
                            <Setter TargetName="AccentBar"   Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <!-- Hover in -->
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <!-- Hover out -->
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.18"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         CONSOLE
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="ConsoleContainerStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource ConsoleBgBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="14"/>
    </Style>

    <Style x:Key="ConsoleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="Consolas, Courier New, monospace"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Foreground"   Value="#a6e3a1"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Margin"       Value="0,1"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         TYPOGRAPHY
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,20"/>
    </Style>

    <Style x:Key="PageSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,10"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,12"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin"     Value="0,4,0,0"/>
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         EMPTY STATE
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"              Value="13"/>
        <Setter Property="Foreground"            Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment"   Value="Center"/>
        <Setter Property="Margin"                Value="0,32"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         ERROR / STATUS BARS
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="ErrorBarStyle" TargetType="Border">
        <Setter Property="Background"   Value="{DynamicResource DangerBadgeBgBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding"      Value="14,10"/>
        <Setter Property="Margin"       Value="0,0,0,12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"  Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style x:Key="InfoBarStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource InfoBadgeBgBrush}"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="14,10"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         TOOLBAR CONTAINER
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="ToolbarContainerStyle" TargetType="Border">
        <Setter Property="Padding"         Value="0,0,0,16"/>
        <Setter Property="BorderThickness" Value="0,0,0,0"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         STATUS BADGES (legacy Border-based)
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="OnlineBadgeStyle" TargetType="Border">
        <Setter Property="Background"   Value="{DynamicResource SuccessBadgeBgBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding"      Value="10,3"/>
    </Style>

    <Style x:Key="OfflineBadgeStyle" TargetType="Border">
        <Setter Property="Background"   Value="{DynamicResource DangerBadgeBgBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding"      Value="10,3"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         PAGE FADE-IN ANIMATION
    ══════════════════════════════════════════════════════ -->

    <Storyboard x:Key="PageFadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.22">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ══════════════════════════════════════════════════════
         SIDEBAR SECTION LABEL
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="SidebarSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin"     Value="20,12,0,4"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════
         SEPARATOR
    ══════════════════════════════════════════════════════ -->

    <Style x:Key="SidebarSeparatorStyle" TargetType="Border">
        <Setter Property="Height"          Value="1"/>
        <Setter Property="Background"      Value="{DynamicResource SubtleBorderBrush}"/>
        <Setter Property="Margin"          Value="12,6"/>
    </Style>

</ResourceDictionary>
